{% comment %}
  Section: Hero Typewriter
  Full-screen dark hero with:
  - Background image (product shot)
  - Typewriter cycling text effect on the headline
  - Subtitle + CTA button
{% endcomment %}

<section class="hero-typewriter" id="hero-typewriter-{{ section.id }}">

  <!-- Background image -->
  {% if section.settings.bg_image %}
    <div class="hero-tw__bg">
      <img
        src="{{ section.settings.bg_image | image_url: width: 1800 }}"
        alt="{{ section.settings.bg_image.alt | escape }}"
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.height }}"
        loading="eager"
      >
    </div>
  {% endif %}

  <!-- Overlay gradient -->
  <div class="hero-tw__overlay"></div>

  <!-- Content -->
  <div class="hero-tw__content">
    {% if section.settings.eyebrow != blank %}
      <p class="hero-tw__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    <h1 class="hero-tw__heading">
      {{ section.settings.heading_prefix }}<span class="hero-tw__typed" id="tw-typed-{{ section.id }}" aria-live="polite"></span><span class="hero-tw__cursor" aria-hidden="true">|</span>
    </h1>

    {% if section.settings.subtitle != blank %}
      <p class="hero-tw__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="hero-tw__btn">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>

</section>

{% style %}
  #hero-typewriter-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #020d1a;
  }

  #hero-typewriter-{{ section.id }} .hero-tw__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #hero-typewriter-{{ section.id }} .hero-tw__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    display: block;
  }

  #hero-typewriter-{{ section.id }} .hero-tw__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(2, 13, 26, 0.85) 0%,
      rgba(2, 13, 26, 0.55) 50%,
      rgba(2, 13, 26, 0.10) 100%
    );
  }

  #hero-typewriter-{{ section.id }} .hero-tw__content {
    position: relative;
    z-index: 2;
    max-width: 580px;
    padding: 80px 5vw;
  }

  #hero-typewriter-{{ section.id }} .hero-tw__eyebrow {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 20px;
  }

  #hero-typewriter-{{ section.id }} .hero-tw__heading {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 300;
    line-height: 1.1;
    color: #ffffff;
    margin: 0 0 24px;
    letter-spacing: -0.02em;
  }

  #hero-typewriter-{{ section.id }} .hero-tw__typed {
    color: #7ecfff;
    font-weight: 400;
  }

  #hero-typewriter-{{ section.id }} .hero-tw__cursor {
    display: inline-block;
    color: #7ecfff;
    font-weight: 300;
    margin-left: 2px;
    transition: opacity 0.1s;
  }

  #hero-typewriter-{{ section.id }} .hero-tw__cursor--hide {
    opacity: 0;
  }

  #hero-typewriter-{{ section.id }} .hero-tw__subtitle {
    font-size: 15px;
    font-weight: 400;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 36px;
    max-width: 440px;
  }

  #hero-typewriter-{{ section.id }} .hero-tw__btn {
    display: inline-block;
    padding: 14px 36px;
    border: 1.5px solid rgba(255, 255, 255, 0.8);
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    background: transparent;
    cursor: pointer;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }

  #hero-typewriter-{{ section.id }} .hero-tw__btn:hover {
    background: #ffffff;
    color: #020d1a;
    border-color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    #hero-typewriter-{{ section.id }} .hero-tw__overlay {
      background: rgba(2, 13, 26, 0.72);
    }

    #hero-typewriter-{{ section.id }} .hero-tw__content {
      padding: 60px 24px;
      max-width: 100%;
    }
  }
{% endstyle %}

<script>
(function () {
  var el = document.getElementById('tw-typed-{{ section.id }}');
  var cursor = document.querySelector('#hero-typewriter-{{ section.id }} .hero-tw__cursor');
  if (!el) return;

  var phrases = {{ section.settings.typewriter_phrases | split: '|' | json }};
  if (!phrases || phrases.length === 0) {
    phrases = ['GHK-CU Complex', 'Beef Tallow', 'Peptide Science'];
  }

  var TYPING_SPEED  = {{ section.settings.typing_speed }};
  var ERASING_SPEED = {{ section.settings.erasing_speed }};
  var PAUSE_TYPED   = {{ section.settings.pause_after_type }};
  var PAUSE_ERASED  = {{ section.settings.pause_after_erase }};

  var phraseIndex = 0;
  var charIndex   = 0;
  var isErasing   = false;

  function tick() {
    var current = phrases[phraseIndex] || '';

    if (!isErasing) {
      charIndex++;
      el.textContent = current.substring(0, charIndex);

      if (charIndex === current.length) {
        isErasing = true;
        setTimeout(tick, PAUSE_TYPED);
        return;
      }
      setTimeout(tick, TYPING_SPEED);
    } else {
      charIndex--;
      el.textContent = current.substring(0, charIndex);

      if (charIndex === 0) {
        isErasing   = false;
        phraseIndex = (phraseIndex + 1) % phrases.length;
        setTimeout(tick, PAUSE_ERASED);
        return;
      }
      setTimeout(tick, ERASING_SPEED);
    }
  }

  setInterval(function () {
    if (cursor) cursor.classList.toggle('hero-tw__cursor--hide');
  }, 530);

  setTimeout(tick, 600);
})();
</script>

{% schema %}
{
  "name": "Hero Typewriter",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text (above heading)"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading prefix (before animated text)",
      "default": "Powered by "
    },
    {
      "type": "textarea",
      "id": "typewriter_phrases",
      "label": "Typewriter phrases (separate with |)",
      "default": "GHK-CU Complex|Beef Tallow|Peptide Science|Real Science"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "No other skincare formula works like this. Clinically supported ingredients. Real skin repair."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "typing_speed",
      "label": "Typing speed (ms per character)",
      "min": 30,
      "max": 200,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "erasing_speed",
      "label": "Erasing speed (ms per character)",
      "min": 20,
      "max": 150,
      "step": 10,
      "default": 40
    },
    {
      "type": "range",
      "id": "pause_after_type",
      "label": "Pause after fully typed (ms)",
      "min": 500,
      "max": 5000,
      "step": 250,
      "default": 2000
    },
    {
      "type": "range",
      "id": "pause_after_erase",
      "label": "Pause after fully erased (ms)",
      "min": 200,
      "max": 2000,
      "step": 100,
      "default": 500
    }
  ],
  "presets": [
    {
      "name": "Hero Typewriter"
    }
  ]
}
{% endschema %}
