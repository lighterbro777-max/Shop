{% comment %}
  Section: Before/After Image Slider
  Left: headline + subtext
  Right: interactive before/after drag slider
{% endcomment %}

<div class="before-after-section" id="before-after-{{ section.id }}">

  <!-- Top wave (coming from dark section above) -->
  {% if section.settings.show_top_wave %}
    <div class="before-after__wave-top" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,40 C200,80 500,0 800,40 C1100,80 1300,0 1440,40 L1440,0 L0,0 Z" fill="{{ section.settings.wave_bg_color }}"/>
      </svg>
    </div>
  {% endif %}

  <div class="before-after__container">

    <!-- Left: Text -->
    <div class="before-after__text">
      <h2 class="before-after__heading">
        {{ section.settings.heading }}
        <span class="before-after__heading-wave" aria-hidden="true">
          <svg viewBox="0 0 220 16" fill="none" xmlns="http://www.w3.org/2000/svg" width="220" height="16">
            <path d="M2 8 C40,2 80,14 120,8 C160,2 200,14 218,8" stroke="#4a8bb5" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          </svg>
        </span>
      </h2>
      <p class="before-after__subtext">{{ section.settings.subtext }}</p>
    </div>

    <!-- Right: Slider -->
    <div class="before-after__slider-wrap">
      <div class="ba-slider" id="ba-slider-{{ section.id }}">

        <!-- After image (bottom layer, full width) -->
        <div class="ba-slider__after">
          {% if section.settings.after_image %}
            <img src="{{ section.settings.after_image | img_url: '700x700', crop: 'center' }}"
                 alt="{{ section.settings.after_label | escape }}" loading="lazy">
          {% else %}
            <div class="ba-slider__placeholder ba-slider__placeholder--after">After</div>
          {% endif %}
          <span class="ba-slider__label ba-slider__label--after">{{ section.settings.after_label }}</span>
        </div>

        <!-- Before image (top layer, clipped) -->
        <div class="ba-slider__before">
          {% if section.settings.before_image %}
            <img src="{{ section.settings.before_image | img_url: '700x700', crop: 'center' }}"
                 alt="{{ section.settings.before_label | escape }}" loading="lazy">
          {% else %}
            <div class="ba-slider__placeholder ba-slider__placeholder--before">Before</div>
          {% endif %}
          <span class="ba-slider__label ba-slider__label--before">{{ section.settings.before_label }}</span>
        </div>

        <!-- Drag handle -->
        <div class="ba-slider__handle" role="slider" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" tabindex="0" aria-label="Before/after comparison slider">
          <div class="ba-slider__handle-line"></div>
          <div class="ba-slider__handle-circle">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M6 10l-4 0M6 10l-2-2M6 10l-2 2" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M14 10l4 0M14 10l2-2M14 10l2 2" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
(function() {
  var slider = document.getElementById('ba-slider-{{ section.id }}');
  if (!slider) return;

  var beforeEl = slider.querySelector('.ba-slider__before');
  var handle = slider.querySelector('.ba-slider__handle');
  var isDragging = false;

  function setPosition(x) {
    var rect = slider.getBoundingClientRect();
    var pct = Math.min(Math.max((x - rect.left) / rect.width, 0), 1) * 100;
    beforeEl.style.width = pct + '%';
    handle.style.left = pct + '%';
    handle.setAttribute('aria-valuenow', Math.round(pct));
  }

  // Set initial position
  setPosition(slider.getBoundingClientRect().left + slider.getBoundingClientRect().width / 2);

  handle.addEventListener('mousedown', function(e) { isDragging = true; e.preventDefault(); });
  handle.addEventListener('touchstart', function(e) { isDragging = true; }, { passive: true });

  document.addEventListener('mousemove', function(e) {
    if (isDragging) setPosition(e.clientX);
  });
  document.addEventListener('touchmove', function(e) {
    if (isDragging && e.touches[0]) setPosition(e.touches[0].clientX);
  }, { passive: true });
  document.addEventListener('mouseup', function() { isDragging = false; });
  document.addEventListener('touchend', function() { isDragging = false; });

  // Keyboard support
  handle.addEventListener('keydown', function(e) {
    var rect = slider.getBoundingClientRect();
    var currentPct = parseFloat(beforeEl.style.width) || 50;
    if (e.key === 'ArrowLeft') setPosition(rect.left + (currentPct - 5) / 100 * rect.width);
    if (e.key === 'ArrowRight') setPosition(rect.left + (currentPct + 5) / 100 * rect.width);
  });
})();
</script>

{% schema %}
{
  "name": "Before / After Slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_top_wave",
      "label": "Show top wave divider",
      "default": true
    },
    {
      "type": "color",
      "id": "wave_bg_color",
      "label": "Wave color (matches section above)",
      "default": "#0d1b2a"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Notice The Change"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "The difference after consistent use"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    }
  ],
  "presets": [
    {
      "name": "Before / After Slider"
    }
  ]
}
{% endschema %}
